# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=transjakarta
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# MQTT
MQTT_PORT=1883
MQTT_WS_PORT=9001

# Adminer
ADMINER_PORT=8080

# App
APP_PORT=8000

# Observability
DOZZLE_PORT=8088
MQTT_EXPLORER_PORT=3001

# Geofence
GEOFENCE_LAT=-6.175392
GEOFENCE_LNG=106.827153
GEOFENCE_RADIUS_M=50
# Masa berlaku state "sedang di dalam geofence" (detik). Setelah TTL, state
# dianggap basi supaya transisi masuk berikutnya tetap memicu event.
GEOFENCE_STATE_TTL_SECONDS=60
# true = kirim juga event "geofence_exit" saat kendaraan keluar area.
# Default false agar format pesan tetap sama dengan spesifikasi.
GEOFENCE_EMIT_EXIT=false

# Validasi payload lokasi
# Toleransi timestamp ke depan (detik) - handles clock skew perangkat.
LOCATION_MAX_FUTURE_SECONDS=300
# Toleransi data basi ke belakang (detik). 86400 = 24 jam.
LOCATION_MAX_AGE_SECONDS=86400

# Batas menunggu dependency eksternal saat startup (detik)
DEPENDENCY_TIMEOUT_SECONDS=120

# Heartbeat & deteksi offline
# Aktifkan laporan status online/stale/offline pada endpoint /api/heartbeat.
HEARTBEAT_ENABLED=false
# Data kendaraan yang lebih tua dari ini (detik) ditandai "stale".
# Default 30 detik = 15x interval publish publisher (2 detik).
HEARTBEAT_STALE_SECONDS=20
# Data kendaraan yang lebih tua dari ini (detik) ditandai "offline".
# Default 120 detik = 1 menit.
HEARTBEAT_OFFLINE_SECONDS=40

# Publisher (simulator)
PUBLISHER_VEHICLES=B1234XYZ
PUBLISHER_INTERVAL=2
# Periode satu putaran rute shuttle (detik). Dalam satu periode kendaraan
# melewati batas geofence dua kali.
PUBLISHER_ROUTE_PERIOD_SECONDS=60
# Arah garis rute terhadap utara (derajat).
PUBLISHER_ROUTE_BEARING_DEG=45
# Selisih arah antar kendaraan (derajat).
PUBLISHER_ROUTE_SPREAD_DEG=20
